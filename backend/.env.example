# По умолчанию — файл SQLite рядом с приложением: бэкенд поднимается без Docker.
# В docker-compose переменная подставляется автоматически (Postgres).
DATABASE_URL=sqlite:///./finni.db
# DATABASE_URL=postgresql://app:app@localhost:5432/app

# Сколько секунд клиент может держать справочник в кэше, не переспрашивая сервер.
CONTENT_CACHE_MAX_AGE=300
